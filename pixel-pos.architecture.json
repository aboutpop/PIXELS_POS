  "cards": [
    {
      "dot": "amber",
      "title": "Tier 1 & 2: Shell, PWA & Dual-Device Ergonomics",
      "items": [
        "SPA Architecture with In-Memory View Cache (Map) & PWA Service Worker (sw.js)",
        "Dual-Device Target Profiles: Profile A (Tablet 1024x640 Landscape, inputmode='none') & Profile B (Mobile 1260x2800 Portrait, single-scroll accordion)",
        "Top Navigation: POS Cashier, Payment, Products, Categories, Stock-In, Sales Orders, Dashboard & Settings"
      ]
    },
    {
      "dot": "emerald",
      "title": "Tier 3: Sub-Views, Hardware Integration & AI Subsystems",
      "items": [
        "POS Hardware Barcode: Dual-Threshold Cadence (160ms/350ms wake-up), Thai Pattachote/Kasemani Auto-Correction, Bluetooth Sleep Wake Auto-Sync",
        "Checkout & Printing: Quick Cash Calculator, Dynamic EMVCo PromptPay QR (CRC16), Split Payment, Web Bluetooth ESC/POS Direct Thermal Printer",
        "Inventory & Vision: Product CRUD with Thai Voice Dictation, 900x900 Square Camera Viewfinder, Multimodal Gemini Flash OCR Bill Ingestion & Stock AI Hygiene Audit"
      ]
    },
    {
      "dot": "violet",
      "title": "Tier 4: State, Offline-First Persistence & Cloud Resilience",
      "items": [
        "Zero-Latency Web Audio Engine with preloaded 25 Thai voice tracks (Aoede TTS) + Retro 8-bit Chiptune SFX",
        "Local-First Instant Checkout (<50ms) queues to Dexie offline_orders with Resilient Background Sync",
        "Google Drive CDN (lh3.googleusercontent.com) via GAS Web App with Service Worker Cache-First (pixel-pos-images-v1) and Image Deduplication",
        "5-Tier Resilient dbHelper.js (Atomic PostgreSQL RPCs, Dual-Client primary+anon, PGRST204 column pruning, safeIdCompare) & Gemini Multi-Model Fallback"
      ]
    }
